# Copy to .env and fill in. Values here are the safe local defaults, not secrets.
#
# ── Database ─────────────────────────────────────────────────────────────────
#
# MONGO_DB_URI is the deployed connection string. Outside production it is
# IGNORED unless it points at this machine, because the same .env tends to hold
# the production cluster and `npm run dev` should never write to it.
#
# Development resolves in this order:
#   1. MONGO_DB_URI_DEV     an explicit development database, always honoured
#   2. MONGO_DB_URI         only when local, or when ALLOW_REMOTE_DB=true
#   3. mongodb://127.0.0.1:27017/famlink   the default — `npm run db:up`
#
MONGO_DB_URI=mongodb://127.0.0.1:27017/famlink

# Point local work at a different database without touching MONGO_DB_URI.
# MONGO_DB_URI_DEV=mongodb://127.0.0.1:27017/scratch

# Deliberate escape hatch: lets a local process use a remote database, e.g. to
# debug against staging. Off unless typed. Never set this to reach production.
# ALLOW_REMOTE_DB=true

# ── Secrets required at boot ─────────────────────────────────────────────────
# Missing any of these is a hard failure in production and a warning elsewhere.
JWT_SECRET=dev_jwt_secret
REFRESH_TOKEN_SECRET=dev_refresh_secret

# ── Everything below is optional locally ─────────────────────────────────────
# Features that need them degrade rather than crash; see src/config/index.js for
# the full list and each default.
PORT=3000
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EMAIL_HOST=
# EMAIL_USER=
# EMAIL_PASS=
# REDIS_HOST=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# CLOUDINARY_SECRET=
