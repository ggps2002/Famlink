# ── Security headers ────────────────────────────────────────────────────────
#
# Applied to every response. These are the four Lighthouse reports under "Trust
# and Safety", minus one: see the note on CSP at the end.
#
# COOP is `same-origin-allow-popups`, NOT `same-origin`. Google Sign-In opens its
# consent flow in a popup and talks back to the opener; plain `same-origin`
# severs that reference and the popup completes but the app never learns the
# result, so sign-in hangs with no error. `allow-popups` keeps the isolation for
# everything else and keeps that one channel open.
#
# HSTS carries no `preload`. Submitting to the preload list is close to
# irreversible and this host is a workers.dev subdomain — a domain that is not
# ours to make that commitment for. A year of enforcement is the part worth
# having.
#
# No CSP here yet, deliberately. The app loads Google Identity Services, Stripe
# and Cloudinary, and antd injects its styles as inline <style> tags at runtime,
# so a policy tight enough to satisfy the audit is also tight enough to white-
# screen the site if one source is missed. It wants building behind
# Content-Security-Policy-Report-Only first, over real traffic, and promoting
# once the reports are quiet. Worth doing — but as its own change, not as a
# line added blind to a headers file.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Cache policy for the static deploy (Cloudflare reads this from the build output).
#
# The default the Worker was serving is `public, max-age=0, must-revalidate` for
# everything, including the content-hashed bundles. That makes a repeat visit
# revalidate all ~45 critical-path files before it can paint, which on a slow
# connection costs a full round trip per file for assets that can never change.
#
# Anything under /assets/ carries a content hash in its name, so a change ships
# under a new URL and the old one is safe to keep forever. `immutable` also stops
# the revalidation a plain max-age still allows on reload.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and root-level images are served from stable, unhashed paths, so they
# cannot be `immutable` — replacing one reuses its URL. A month is long enough to
# cover repeat visits and short enough that a swap is picked up.
/fonts/*
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/blog/*
  Cache-Control: public, max-age=2592000

# The HTML is the one file that must stay fresh: it names the current hashed
# bundles, so a stale copy pins the whole app to an old deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
